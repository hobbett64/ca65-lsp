{
    "scopeName": "source.ca65",
    "name": "ca65 Assembly",
    "patterns": [
        {
            "name": "comment.block.c.ca65",
            "begin": "/\\*",
            "end": "\\*/"
        },
        {
            "name": "comment.line.semicolon.ca65",
            "match": ";.*$"
        },
        {
            "name": "string.quoted.double.ca65",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.ca65",
                    "match": "\\\\."
                }
            ]
        },
        {
            "name": "string.quoted.single.ca65",
            "begin": "'",
            "end": "'",
            "patterns": [
                {
                    "name": "constant.character.escape.ca65",
                    "match": "\\\\."
                }
            ]
        },
        {
            "name": "meta.namespace",
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(::)",
            "captures": {
                "1": { "name": "entity.name.namespace.ca65" },
                "2": { "name": "punctuation.separator.namespace.ca65" }
            }
        },
        {
            "match": "^\\s*(:)(?=\\s|$|;)",
            "captures": {
                "1": { "name": "entity.name.label.anonymous.ca65" }
            }
        },
        {
            "name": "variable.other.label.anonymous.ca65",
            "match": ":[-+<>]+"
        },
        {
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=:)",
            "captures": {
                "1": { "name": "entity.name.function.ca65" }
            }
        },
        {
            "match": "(@[a-zA-Z0-9_]*)(?=:)",
            "captures": {
                "1": { "name": "entity.name.label.cheap.ca65" }
            }
        },
        {
            "match": "(?i)^\\s*(\\.(?:proc|macro))\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
            "captures": {
                "1": { "name": "keyword.control.directive.ca65" },
                "2": { "name": "entity.name.function.ca65" }
            }
        },
        {
            "match": "(?i)^\\s*(\\.define)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
            "captures": {
                "1": { "name": "keyword.control.directive.ca65" },
                "2": { "name": "variable.other.constant.ca65" }
            }
        },
        {
            "match": "(?i)^\\s*(\\.(?:struct|union))\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
            "captures": {
                "1": { "name": "keyword.control.directive.ca65" },
                "2": { "name": "entity.name.type.struct.ca65" }
            }
        },
        {
            "match": "(?i)^\\s*(\\.enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
            "captures": {
                "1": { "name": "keyword.control.directive.ca65" },
                "2": { "name": "entity.name.type.enum.ca65" }
            }
        },
        {
            "match": "(?i)^\\s*(\\.scope)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
            "captures": {
                "1": { "name": "keyword.control.directive.ca65" },
                "2": { "name": "entity.name.namespace.ca65" }
            }
        },
        {
            "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:?=)",
            "captures": {
                "1": { "name": "variable.other.constant.ca65" },
                "2": { "name": "keyword.operator.assignment.ca65" }
            }
        },
        {
            "name": "keyword.control.directive.ca65",
            "match": "\\.[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
            "name": "keyword.control.flow.ca65",
            "match": "(?i)\\b(jsr|jmp|bcc|bcs|beq|bmi|bne|bpl|bvc|bvs|rts|rti|brk)\\b"
        },
        {
            "name": "keyword.operator.immediate.ca65",
            "match": "#"
        },
        {
            "name": "constant.numeric.ca65",
            "match": "(?:\\$[0-9a-fA-F]+|%[01]+|[0-9]+)\\b"
        },
        {
            "match": ",\\s*(?i)([xy])\\b",
            "captures": {
                "1": { "name": "variable.language.register.ca65" }
            }
        },
        {
            "match": "(?i)\\b(?:asl|lsr|rol|ror|inc|dec)\\s+(a)\\b",
            "captures": {
                "1": { "name": "variable.language.register.ca65" }
            }
        },
        {
            "name": "variable.other.symbol.ca65",
            "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        },
        {
            "name": "variable.other.symbol.cheap.ca65",
            "match": "@[a-zA-Z0-9_]*"
        }
    ]
}
