{
  "comments": {
    "blockComment": [
      "/*",
      "*/"
    ],
    "lineComment": {
      "comment": ";",
      "noIndent": false
    }
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "wordPattern": "(:[-+<>]+)|(@[a-zA-Z0-9_]+|[a-zA-Z_.][a-zA-Z0-9_]*)|(^\\s*:)",
  "onEnterRules": [
    {
      "beforeText": "^\\s*(:|[a-zA-Z_@.][a-zA-Z0-9_@.]*:)\\s*(;.*)?$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*;;;.*$",
      "action": {
        "indent": "none",
        "appendText": ";;; "
      }
    }
  ]
}
