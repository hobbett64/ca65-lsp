# Ignore packaged artifacts and build intermediates
dist/
**/*.vsix
**/*.tsbuildinfo
**/*.js.map
tsconfig.json

# Ignore TypeScript source files and tests (compiled JS lives in client/out and server/out)
client/src/
server/src/
test/

# Ignore development and testing files
.vscode-test/
.vscode/**
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/extensions.json
.gitignore
.gitattributes

# Ignore common junk files
.DS_Store
Thumbs.db
*.log

# Aggressively clean up packaged dependencies
**/node_modules/**/*.md
**/node_modules/**/LICENSE*
**/node_modules/**/test*
**/node_modules/**/example*
**/node_modules/**/.bin
**/node_modules/**/*.d.ts
