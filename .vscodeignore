# Ignore packaged artifacts and build intermediates
dist/
**/*.vsix
**/*.tsbuildinfo
**/*.js.map
**/tsconfig.json

# Exclude bundled node_modules and unbundled tsc intermediates (only esbuild entry bundles ship)
node_modules/**
client/out/*.js
!client/out/extension.js
server/out/*.js
!server/out/server.js

# Ignore TypeScript source files and tests
client/src/
server/src/
test/

# Ignore development and testing files
.vscode-test/
.vscode/**
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/extensions.json
.gitignore
.gitattributes

# Ignore common junk files
.DS_Store
Thumbs.db
*.log

# Example projects
examples/

# Neovim plugin (installed from this repo by Neovim plugin managers, not part of the extension)
lua/
plugin/
ftplugin/
ftdetect/
syntax/
after/
build.lua
.luarc.json

# Release tooling
.github/
scripts/
