{
    "name": "ca65-vscode-extension",
    "description": "ca65 Assembly language support for VS Code",
    "author": "Quang Luong",
    "license": "MIT",
    "version": "2.3.0",
    "publisher": "hobbett",
    "repository": {
        "type": "git",
        "url": "https://github.com/hobbett64/ca65-vscode-extension-64.git"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "main": "./client/out/extension.js",
    "activationEvents": [
        "onLanguage:ca65"
    ],
    "contributes": {
        "languages": [
            {
                "id": "ca65",
                "aliases": [
                    "ca65 Assembly",
                    "ca65"
                ],
                "extensions": [
                    ".s",
                    ".asm",
                    ".inc"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "ca65",
                "scopeName": "source.ca65",
                "path": "./syntaxes/ca65.tmLanguage.json"
            }
        ],
        "configurationDefaults": {
            "[ca65]": {
                "editor.stickyScroll.defaultModel": "foldingProviderModel",
                "editor.wordBasedSuggestions": "off",
                "editor.suggest.snippetsPreventQuickSuggestions": true
            }
        },
        "configuration": {
            "title": "ca65 Language Support",
            "properties": {
                "ca65.executablePath": {
                    "type": "string",
                    "description": "Path to the ca65 compiler executable. If unset, ca65 is resolved from PATH.",
                    "order": 1
                },
                "ca65.fileExtensions": {
                    "type": "array",
                    "description": "File extensions indexed and watched by the ca65 language server.",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        ".s",
                        ".asm",
                        ".inc"
                    ],
                    "order": 2
                },
                "ca65.cpu": {
                    "type": "string",
                    "enum": [
                        "6502",
                        "65SC02",
                        "65C02",
                        "W65C02",
                        "65816"
                    ],
                    "enumDescriptions": [
                        "NMOS 6502 (NES, C64, Atari 2600/800, Apple II)",
                        "CMOS 65SC02 (Atari Lynx, early Apple IIc; no bit ops or WAI/STP)",
                        "CMOS 65C02 with Rockwell bit instructions (BBR/BBS/RMB/SMB)",
                        "Full WDC 65C02S with Rockwell bit ops plus WAI/STP (Commander X16; requires cc65 2.19+)",
                        "WDC 65C816 16-bit (SNES / Super Famicom, Apple IIgs)"
                    ],
                    "description": "Target CPU architecture used for instruction hovers, completions, timing/size estimates, reference guide, and `ca65 --cpu` diagnostics.",
                    "default": "6502",
                    "order": 3
                },
                "ca65.includeDirs": {
                    "type": "array",
                    "description": "Workspace-relative (or glob) paths to search for `.include` statements after the current file's directory.",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/include"
                    ],
                    "order": 4
                },
                "ca65.binIncludeDirs": {
                    "type": "array",
                    "description": "Workspace-relative (or glob) paths to search for `.incbin` statements after the current file's directory.",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "order": 5
                },
                "ca65.implicitImports": {
                    "type": "boolean",
                    "description": "Treats undefined symbols as imports without requiring explicit `.import` declarations (`ca65 --auto-import`).",
                    "default": false,
                    "order": 6
                },
                "ca65.cComments": {
                    "type": "boolean",
                    "description": "Enables `--feature c_comments` for C-style block comments (`/* ... */`) when supported by ca65.",
                    "default": true,
                    "order": 7
                },
                "ca65.lineContinuations": {
                    "type": "boolean",
                    "description": "Enables `--feature line_continuations` for backslash (`\\`) line continuations when supported by ca65.",
                    "default": true,
                    "order": 8
                },
                "ca65.additionalArgs": {
                    "type": "array",
                    "description": "Additional command-line arguments passed to ca65 (e.g. `\"-D\"`, `\"DEBUG=1\"`, `\"-s\"`). Output flags (`-o`, `-l`, `--listing`, `--create-dep`, `--create-full-dep`) are ignored.",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "order": 9
                },
                "ca65.enableStderrDiagnostics": {
                    "type": "boolean",
                    "description": "Enables diagnostics powered by ca65 stderr.",
                    "default": true,
                    "order": 10
                },
                "ca65.enableUnusedSymbolDiagnostics": {
                    "type": "boolean",
                    "description": "Enables unused symbol diagnostics.",
                    "default": true,
                    "order": 11
                },
                "ca65.anonymousLabelIndexHints": {
                    "type": "boolean",
                    "description": "Enables inlay hints for anonymous label indexes.",
                    "default": true,
                    "order": 12
                },
                "ca65.importFromHints": {
                    "type": "boolean",
                    "description": "Enables inlay hints to display the origin file of an import.",
                    "default": true,
                    "order": 13
                },
                "ca65.enableStatusBarCycleCount": {
                    "type": "boolean",
                    "description": "Shows estimated cycle count and byte size for the selected instructions (or current line) in the status bar.",
                    "default": true,
                    "order": 14
                },
                "ca65.enableStatusBarSegment": {
                    "type": "boolean",
                    "description": "Shows the active ca65 segment for the current cursor line in the status bar.",
                    "default": true,
                    "order": 15
                },
                "ca65.smartFolding": {
                    "type": "boolean",
                    "description": "Enables smart folding based on scopes, procs, and other blocks. Disable to use the editor's default folding.",
                    "default": true,
                    "order": 16
                },
                "ca65.autoIncludeExtensions": {
                    "type": "array",
                    "description": "A list of extensions for which we will provide auto-include candidates.",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        ".inc"
                    ],
                    "order": 17
                },
                "ca65.enableCa65StdErrDiagnostics": {
                    "type": "boolean",
                    "deprecationMessage": "Deprecated: use `ca65.enableStderrDiagnostics` instead.",
                    "description": "Deprecated alias for `ca65.enableStderrDiagnostics`.",
                    "order": 98
                },
                "ca65.additionalExtensions": {
                    "type": "array",
                    "deprecationMessage": "Deprecated: add extra extensions to `ca65.fileExtensions` instead.",
                    "description": "Deprecated list of additional extensions indexed alongside `.s`, `.asm`, and `.inc`.",
                    "items": {
                        "type": "string"
                    },
                    "order": 99
                }
            }
        },
        "commands": [
            {
                "command": "ca65.showReference",
                "title": "ca65: Show Instruction Reference"
            },
            {
                "command": "ca65.showHexListing",
                "title": "ca65: Show Hex & Address Listing Side-by-Side",
                "icon": "$(file-binary)"
            },
            {
                "command": "ca65.dumpDebugInfo",
                "title": "ca65: Dump Debug Info to Output"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "ca65.showHexListing",
                    "when": "editorLangId == ca65",
                    "enablement": "!ca65.listingError",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run bundle",
        "compile": "tsc -b tsconfig.json",
        "bundle": "npm run compile && esbuild client/src/extension.ts --bundle --outfile=client/out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap --minify && esbuild server/src/server.ts --bundle --outfile=server/out/server.js --format=cjs --platform=node --target=node18 --sourcemap --minify",
        "watch": "tsc -b tsconfig.json -w",
        "test": "npm run compile && node test/run_all.js"
    },
    "devDependencies": {
        "@types/node": "^24.3.0",
        "@types/vscode": "^1.85.0",
        "@types/which": "^3.0.4",
        "esbuild": "^0.28.2",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1",
        "vscode-languageserver": "^9.0.1",
        "vscode-languageserver-protocol": "^3.17.5",
        "vscode-languageserver-textdocument": "^1.0.1",
        "vscode-languageserver-types": "^3.17.5",
        "vscode-uri": "^3.1.0",
        "which": "^5.0.0"
    }
}
